{
    "manifest_version": 3,
    "name": "Phishing Website Detector",
    "version": "1.0",
    "description": "Detects phishing websites and stores alerts.",
    "permissions": ["tabs", "notifications", "storage"],
    "host_permissions": ["http://127.0.0.1:5000/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Phishing Alerts"
    },
    "icons": {
      "128": "icon.png"
    }
  }
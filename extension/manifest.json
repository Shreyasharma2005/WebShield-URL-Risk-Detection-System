{
    "manifest_version": 3,
    "name": "WebShield - Phishing Detection System",
    "version": "2.0",
    "description": "Real-time phishing detection using URL and webpage analysis.",

    "permissions": [
        "tabs",
        "notifications",
        "storage"
    ],

    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "http://*/*",
        "https://*/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "action": {
        "default_title": "WebShield",
        "default_popup": "popup.html"
    },

    "icons": {
        "128": "icon.png"
    }
}